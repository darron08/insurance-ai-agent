POSTGRES_DB=insurance_agent
POSTGRES_USER=insurance
POSTGRES_PASSWORD=insurance_dev
POSTGRES_PORT=5432
DATABASE_URL=postgres://insurance:insurance_dev@localhost:5432/insurance_agent?sslmode=disable

# The default M4 model runs locally through vLLM. A loopback service needs no
# key; set a real key only when EMBEDDING_BASE_URL points to a remote service.
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=http://127.0.0.1:8001/v1
EMBEDDING_MODEL=Qwen/Qwen3-Embedding-0.6B
